d>0,01</td><td>967</td><td>ламинарный, 64/Re</td><td>0,0662</td><td>0,047</td><td>0,3</td><td>0,1</td><td>0,3</td><td>667,6</td><td>0,668</td><td>0,709</td></tr><tr><td>4</td><td>Т3.1 / Т4.1</td><td>14</td><td>14 → 10</td><td>Т4</td><td>кольцевой</td><td>Сталь ВГП оцинкованная ГОСТ 3262-75</td><td>50</td><td>53,0</td><td>—</td><td>6,00</td><td>52,06</td><td>125,1</td><td>0,0354</td><td>0,02</td><td>1777</td><td>ламинарный, 64/Re</td><td>0,0360</td><td>0,086</td><td>0,5</td><td>0,1</td><td>0,6</td><td>—</td><td>0,001</td><td>0,710</td></tr><tr><td>4</td><td>Т3.1 / Т4.1</td><td>9</td><td>10 → 6</td><td>Т4</td><td>кольцевой</td><td>Сталь ВГП оцинкованная ГОСТ 3262-75</td><td>50</td><td>53,0</td><td>2,384</td><td>6,00</td><td>58,06</td><td>202,2</td><td>0,0572</td><td>0,03</td><td>2872</td><td>переход 64/Re → Шевелёв, неновые</td><td>0,0313</td><td>0,195</td><td>1,2</td><td>0,2</td><td>1,4</td><td>—</td><td>0,001</td><td>0,711</td></tr><tr><td>4</td><td>Т3.1 / Т4.1</td><td>5</td><td>6 → 4</td><td>Т4</td><td>кольцевой</td><td>Сталь ВГП оцинкованная ГОСТ 3262-75</td><td>50</td><td>53,0</td><td>2,384</td><td>4,00</td><td>62,06</td><td>298,8</td><td>0,0844</td><td>0,04</td><td>4243</td><td>Шевелёв, неновые</td><td>0,0547</td><td>0,743</td><td>3,0</td><td>0,6</td><td>3,6</td><td>—</td><td>0,004</td><td>0,715</td></tr><tr><td>4</td><td>Т3.1 / Т4.1</td><td>3</td><td>4 → 2</td><td>Т4</td><td>кольцевой</td><td>Сталь ВГП оцинкованная ГОСТ 3262-75</td><td>50</td><td>53,0</td><td>2,384</td><td>2,00</td><td>64,06</td><td>298,8</td><td>0,0844</td><td>0,04</td><td>4243</td><td>Шевелёв, неновые</td><td>0,0547</td><td>0,743</td><td>1,5</td><td>0,3</td><td>1,8</td><td>—</td><td>0,002</td><td>0,717</td></tr><tr><td>Итог 4</td><td>Т3.1 / Т4.1</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td>64,06</td><td>64,06</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td>0,717</td><td>0,717</td></tr></tbody></table><p class="about">Что означают столбцы:</p><table class="notes"><tbody><tr><td class="name">Кольцо</td><td>номер кольца, к которому относится строка</td></tr><tr><td class="name">Система</td><td>имя зоны: пара подающей Т3 и циркуляционной Т4 с общим выходом из ИТП</td></tr><tr><td class="name">№ уч.</td><td>номер участка в общей нумерации сети</td></tr><tr><td class="name">Узлы</td><td>номера узлов, между которыми лежит участок</td></tr><tr><td class="name">Роль</td><td>Т3 — подающий трубопровод, Т4 — циркуляционный</td></tr><tr><td class="name">Тип</td><td>труба, перемычка Т3–Т4 или связь внутри ИТП</td></tr><tr><td class="name">Материал</td><td>материал трубы: от него зависят внутренний диаметр, шероховатость и сопротивление стенки</td></tr><tr><td class="name">Ду, мм</td><td>условный диаметр по каталогу</td></tr><tr><td class="name">Dвн, мм</td><td>настоящий внутренний диаметр — по нему считаются скорость и потери, а не по условному</td></tr><tr><td class="name">k_э, мм</td><td>эквивалентная шероховатость, принятая в расчёте. У стали выведена по Шевелёву для неновых труб и зависит от диаметра; в ламинарном режиме не участвует и не показывается</td></tr><tr><td class="name">Длина, м</td><td>длина участка по геометрии</td></tr><tr><td class="name">Длина по кольцу, м</td><td>нарастающая длина от ИТП по ходу воды</td></tr><tr><td class="name">Расход, кг/ч</td><td>тот же расход массовый — в нём ведётся весь расчёт, потому что Q = c·G·Δt требует массы, а не объёма</td></tr><tr><td class="name">Расход, л/с</td><td>циркуляционный расход</td></tr><tr><td class="name">v, м/с</td><td>скорость воды</td></tr><tr><td class="name">Re</td><td>число Рейнольдса: до 2300 режим ламинарный, выше 4000 турбулентный, между ними переходный</td></tr><tr><td class="name">Закон трения</td><td>по какой зависимости взят коэффициент трения на этом участке</td></tr><tr><td class="name">λ</td><td>коэффициент гидравлического трения</td></tr><tr><td class="name">R, Па/м</td><td>удельное сопротивление — потери на метр трубы</td></tr><tr><td class="name">По длине, Па</td><td>потери на трение по длине участка</td></tr><tr><td class="name">Местные, Па</td><td>потери в отводах, тройниках и арматуре — долей от линейных</td></tr><tr><td class="name">Δp трубы, Па</td><td>потери участка без балансировочного клапана</td></tr><tr><td class="name">Δp клапана, Па</td><td>перепад на балансировочном клапане, если он на участке стоит</td></tr><tr><td class="name">Δp участка, кПа</td><td>полные потери участка</td></tr><tr><td class="name">Нарастающий Δp, кПа</td><td>сумма потерь от ИТП по ходу воды — по ней видно, где теряется напор</td></tr></tbody></table><h2>7. Кольца и увязка</h2><h3>Таблица 12 — Циркуляционные кольца</h3><p class="about">Итоги по кольцам и невязка — излишек напора, который надо погасить балансировочным клапаном.</p><table><thead><tr><th>№</th><th>Система</th><th>Длина, м</th><th>Теплопотери, Вт</th><th>Расход, л/с</th><th>Потери напора, кПа</th><th>t в конце, °C</th><th>Невязка, %</th><th>Δp клапана, кПа</th><th>Требуемый Kv</th><th>Замечание</th></tr></thead><tbody><tr><td>1  ★</td><td>Т3.1 / Т4.1</td><td>92,01</td><td>984</td><td>0,0273</td><td>0,74</td><td>60,00</td><td>0,0</td><td>—</td><td>—</td><td></td></tr><tr><td>2</td><td>Т3.1 / Т4.1</td><td>80,02</td><td>685</td><td>0,0218</td><td>0,76</td><td>60,00</td><td>73,8</td><td>0,55</td><td>1,060</td><td></td></tr><tr><td>3</td><td>Т3.1 / Т4.1</td><td>68,03</td><td>385</td><td>0,0161</td><td>0,77</td><td>60,00</td><td>90,4</td><td>0,67</td><td>0,708</td><td></td></tr><tr><td>4</td><td>Т3.1 / Т4.1</td><td>64,06</td><td>458</td><td>0,0192</td><td>0,72</td><td>60,00</td><td>93,4</td><td>0,69</td><td>0,832</td><td></td></tr></tbody></table><p class="about">Что означают столбцы:</p><table class="notes"><tbody><tr><td class="name">№</td><td>номер кольца</td></tr><tr><td class="name">Система</td><td>имя зоны: пара подающей Т3 и циркуляционной Т4 с общим выходом из ИТП</td></tr><tr><td class="name">Длина, м</td><td>длина участка по геометрии</td></tr><tr><td class="name">Теплопотери, Вт</td><td>теплопотери собственных участков кольца, без общих магистралей</td></tr><tr><td class="name">Расход, л/с</td><td>циркуляционный расход</td></tr><tr><td class="name">Потери напора, кПа</td><td>потери по всему кольцу</td></tr><tr><td class="name">t в конце, °C</td><td>температура в самой дальней точке кольца — та, что должна получиться у потребителя</td></tr><tr><td class="name">Невязка, %</td><td>насколько потери кольца меньше потерь самого невыгодного. Это и есть излишек напора, который надо погасить клапаном</td></tr><tr><td class="name">Δp клапана, кПа</td><td>перепад, который должен создать клапан</td></tr><tr><td class="name">Требуемый Kv</td><td>пропускная способность клапана, нужная для погашения невязки</td></tr><tr><td class="name">Замечание</td><td>что в этой строке требует внимания</td></tr></tbody></table><h2>8. Балансировочная арматура</h2><h3>Таблица 13 — Ведомость балансировочных клапанов</h3><p class="about">Подобранные клапаны и их настройка. Это и есть задание наладчику: артикул и положение рукоятки.</p><table><thead><tr><th>Кольцо</th><th>Система</th><th>Расход, л/с</th><th>Расход, м³/ч</th><th>Потери кольца, кПа</th><th>Потери, бар</th><th>Потери, м вод. ст.</th><th>Невязка, %</th><th>Клапан нужен</th><th>Δp клапана, кПа</th><th>Δp клапана, бар</th><th>Δp клапана, м</th><th>Требуемый Kv</th><th>Ду трубы, мм</th><th>Участок</th><th>Подбор</th><th>Клапан</th><th>Настройка</th><th>Kv на настройке</th><th>Факт. Δp, кПа</th><th>Замечание</th></tr></thead><tbody><tr><td>1</td><td>Т3.1 / Т4.1</td><td>0,0273</td><td>0,098</td><td>0,74</td><td>0,0074</td><td>0,077</td><td>0,0</td><td>нет</td><td>—</td><td>—</td><td>—</td><td>—</td><td>20</td><td>№8</td><td>автоматически</td><td>—</td><td>—</td><td>—</td><td>—</td><td></td></tr><tr><td>2</td><td>Т3.1 / Т4.1</td><td>0,0218</td><td>0,078</td><td>0,76</td><td>0,0076</td><td>0,079</td><td>73,8</td><td>да</td><td>0,55</td><td>0,0055</td><td>0,057</td><td>1,060</td><td>20</td><td>№13</td><td>автоматически</td><td>VALTEC VT.054 1/2" Low Flow (VT.054.NLF.04)</td><td>41</td><td>1,044</td><td>0,56</td><td></td></tr><tr><td>3</td><td>Т3.1 / Т4.1</td><td>0,0161</td><td>0,058</td><td>0,77</td><td>0,0077</td><td>0,079</td><td>90,4</td><td>да</td><td>0,67</td><td>0,0067</td><td>0,070</td><td>0,708</td><td>20</td><td>№18</td><td>автоматически</td><td>VALTEC VT.054 1/2" Low Flow (VT.054.NLF.04)</td><td>32</td><td>0,696</td><td>0,69</td><td></td></tr><tr><td>4</td><td>Т3.1 / Т4.1</td><td>0,0192</td><td>0,069</td><td>0,72</td><td>0,0072</td><td>0,074</td><td>93,4</td><td>да</td><td>0,69</td><td>0,0069</td><td>0,072</td><td>0,832</td><td>50</td><td>№19</td><td>автоматически</td><td>VALTEC VT.054 1/2" Low Flow (VT.054.NLF.04)</td><td>36</td><td>0,848</td><td>0,67</td><td>клапан на два типоразмера уже трубы Ду50 — проверьте, приемлемо ли сужение</td></tr></tbody></table><p class="about">Что означают столбцы:</p><table class="notes"><tbody><tr><td class="name">Кольцо</td><td>номер кольца, к которому относится строка</td></tr><tr><td class="name">Система</td><td>имя зоны: пара подающей Т3 и циркуляционной Т4 с общим выходом из ИТП</td></tr><tr><td class="name">Расход, л/с</td><td>циркуляционный расход</td></tr><tr><td class="name">Расход, м³/ч</td><td>объёмный расход — в нём паспорта арматуры дают Kv</td></tr><tr><td class="name">Потери кольца, кПа</td><td>потери труб кольца без балансировочного клапана</td></tr><tr><td class="name">Потери, бар</td><td>то же в барах: в них паспорта арматуры дают Kv</td></tr><tr><td class="name">Потери, м вод. ст.</td><td>те же потери в метрах водяного столба</td></tr><tr><td class="name">Невязка, %</td><td>насколько потери кольца меньше потерь самого невыгодного. Это и есть излишек напора, который надо погасить клапаном</td></tr><tr><td class="name">Клапан нужен</td><td>требуется ли кольцу балансировочный клапан. Не требуется самому невыгодному кольцу и тем, что уложились в допустимую невязку</td></tr><tr><td class="name">Δp клапана, кПа</td><td>перепад, который должен создать клапан</td></tr><tr><td class="name">Δp клапана, бар</td><td>тот же перепад в барах — в них считается Kv</td></tr><tr><td class="name">Δp клапана, м</td><td>тот же перепад в метрах водяного столба</td></tr><tr><td class="name">Требуемый Kv</td><td>пропускная способность клапана, нужная для погашения невязки</td></tr><tr><td class="name">Ду трубы, мм</td><td>условный диаметр трубы в том месте, где стоит клапан</td></tr><tr><td class="name">Участок</td><td>номер участка, на котором стоит клапан</td></tr><tr><td class="name">Подбор</td><td>типоразмер выбран программой или задан вручную</td></tr><tr><td class="name">Клапан</td><td>типоразмер балансировочного клапана</td></tr><tr><td class="name">Настройка</td><td>настроечное положение рукоятки — это и есть задание наладчику</td></tr><tr><td class="name">Kv на настройке</td><td>пропускная способность на принятом положении</td></tr><tr><td class="name">Факт. Δp, кПа</td><td>перепад, который получится на принятом положении. Отличается от требуемого, потому что шкала дискретна</td></tr><tr><td class="name">Замечание</td><td>что в этой строке требует внимания</td></tr></tbody></table><h3>Таблица 14 — Ход подбора клапанов</h3><p class="about">Как получено каждое число предыдущей таблицы — чтобы подбор можно было пересчитать на бумаге. Последние столбцы показывают цену округления: шкала дискретна, и точно требуемый перепад на ней почти никогда не выставляется.</p><table><thead><tr><th>Кольцо</th><th>Система</th><th>Участок</th><th>Ду трубы, мм</th><th>G, кг/ч</th><th>Q, м³/ч</th><th>Δp кольца (трубы), кПа</th><th>Δp худшего кольца, кПа</th><th>Невязка, %</th><th>Требуемый Δp клапана, кПа</th><th>То же, бар</th><th>Kv = Q/√Δp</th><th>Фирма</th><th>Клапан</th><th>Подбор</th><th>Положение расчётное</th><th>Положение принятое</th><th>Шаг шкалы</th><th>Kv на положении</th><th>Факт. Δp, кПа</th><th>Расхождение, %</th><th>Замечание</th></tr></thead><tbody><tr><td>1  ★</td><td>Т3.1 / Т4.1</td><td>№8</td><td>20</td><td>96,5</td><td>0,0982</td><td>0,742</td><td>0,742</td><td>0,0</td><td>не требуется</td><td>—</td><td>—</td><td>—</td><td>—</td><td>автоматически</td><td>—</td><td>—</td><td>—</td><td>—</td><td>—</td><td>—</td><td></td></tr><tr><td>2</td><td>Т3.1 / Т4.1</td><td>№13</td><td>20</td><td>77,1</td><td>0,0784</td><td>0,194</td><td>0,742</td><td>73,8</td><td>0,548</td><td>0,005480</td><td>1,060</td><td>VALTEC</td><td>VT.054 1/2" Low Flow (VT.054.NLF.04)</td><td>автоматически</td><td>41,36</td><td>41</td><td>1</td><td>1,044</td><td>0,565</td><td>3,0</td><td></td></tr><tr><td>3</td><td>Т3.1 / Т4.1</td><td>№18</td><td>20</td><td>57,0</td><td>0,0580</td><td>0,072</td><td>0,742</td><td>90,4</td><td>0,671</td><td>0,006707</td><td>0,708</td><td>VALTEC</td><td>VT.054 1/2" Low Flow (VT.054.NLF.04)</td><td>автоматически</td><td>32,33</td><td>32</td><td>1</td><td>0,696</td><td>0,695</td><td>3,6</td><td></td></tr><tr><td>4</td><td>Т3.1 / Т4.1</td><td>№19</td><td>50</td><td>68,1</td><td>0,0693</td><td>0,049</td><td>0,742</td><td>93,4</td><td>0,693</td><td>0,006932</td><td>0,832</td><td>VALTEC</td><td>VT.054 1/2" Low Flow (VT.054.NLF.04)</td><td>автоматически</td><td>35,58</td><td>36</td><td>1</td><td>0,848</td><td>0,668</td><td>-3,7</td><td>клапан на два типоразмера уже трубы Ду50 — проверьте, приемлемо ли сужение</td></tr></tbody></table><p class="about">Что означают столбцы:</p><table class="notes"><tbody><tr><td class="name">Кольцо</td><td>номер кольца, к которому относится строка</td></tr><tr><td class="name">Система</td><td>имя зоны: пара подающей Т3 и циркуляционной Т4 с общим выходом из ИТП</td></tr><tr><td class="name">Участок</td><td>номер участка, на котором стоит клапан</td></tr><tr><td class="name">Ду трубы, мм</td><td>условный диаметр трубы в том месте, где стоит клапан</td></tr><tr><td class="name">G, кг/ч</td><td>массовый расход кольца</td></tr><tr><td class="name">Q, м³/ч</td><td>объёмный расход кольца — он и подставляется в формулу Kv</td></tr><tr><td class="name">Δp кольца (трубы), кПа</td><td>потери самого кольца, без клапана</td></tr><tr><td class="name">Δp худшего кольца, кПа</td><td>потери самого невыгодного кольца системы — до них и надо дотянуть все остальные</td></tr><tr><td class="name">Невязка, %</td><td>насколько потери кольца меньше потерь самого невыгодного. Это и есть излишек напора, который надо погасить клапаном</td></tr><tr><td class="name">Требуемый Δp клапана, кПа</td><td>разность предыдущих двух столбцов</td></tr><tr><td class="name">То же, бар</td><td>тот же перепад в барах, с шестью знаками: иначе при циркуляционных расходах он схлопнулся бы в ноль</td></tr><tr><td class="name">Kv = Q/√Δp</td><td>требуемая пропускная способность, посчитанная по формуле в соседних столбцах — её можно пересчитать глазами</td></tr><tr><td class="name">Фирма</td><td>каталог, из которого подобран клапан</td></tr><tr><td class="name">Клапан</td><td>типоразмер балансировочного клапана</td></tr><tr><td class="name">Подбор</td><td>типоразмер выбран программой или задан вручную</td></tr><tr><td class="name">Положение расчётное</td><td>положение до округления, как его дала интерполяция по паспортной таблице</td></tr><tr><td class="name">Положение принятое</td><td>то же после округления до цены деления шкалы — именно это выставляет наладчик</td></tr><tr><td class="name">Шаг шкалы</td><td>цена деления рукоятки этой модели</td></tr><tr><td class="name">Kv на положении</td><td>пропускная способность на принятом положении</td></tr><tr><td class="name">Факт. Δp, кПа</td><td>перепад, который получится на принятом положении. Отличается от требуемого, потому что шкала дискретна</td></tr><tr><td class="name">Расхождение, %</td><td>насколько фактический перепад отличается от требуемого. Это цена округления: точно требуемый перепад на дискретной шкале почти никогда не выставляется</td></tr><tr><td class="name">Замечание</td><td>что в этой строке требует внимания</td></tr></tbody></table><h2>9. ИТП и циркуляционный насос</h2><h3>Таблица 15 — ИТП и насос</h3><p class="about">Данные для теплового пункта: расход, температура обратки, подогрев и нагрузка на циркуляцию, — и подбор насоса по рабочей точке. Каждая строка снабжена пояснением, как получено значение.</p><table><thead><tr><th>Система</th><th>Показатель</th><th>Значение</th><th>Как получено</th></tr></thead><tbody><tr><td>Т3.1 / Т4.1</td><td>Расход циркуляционный, л/с</td><td>0,0844</td><td>сумма расходов колец, подбор по 60 °C у потребителя</td></tr><tr><td>Т3.1 / Т4.1</td><td>то же, м³/ч</td><td>0,304</td><td>G/ρ при ρ = 983 кг/м³</td></tr><tr><td>Т3.1 / Т4.1</td><td>то же, кг/ч</td><td>298,8</td><td>в массовом расходе ведётся весь расчёт: Q = c·G·Δt</td></tr><tr><td>Т3.1 / Т4.1</td><td>Обратка на вводе ИТП, °C</td><td>55,42</td><td>смешение веток Т4 по расходам; не путать с худшей точкой 60,00 °C</td></tr><tr><td>Т3.1 / Т4.1</td><td>Подогрев в ИТП, К</td><td>9,576</td><td>подача 65 °C минус обратка</td></tr><tr><td>Т3.1 / Т4.1</td><td>Нагрузка на циркуляцию, кВт</td><td>3,330</td><td>c·G·Δt при c = 4,19 кДж/(кг·К)</td></tr><tr><td>Т3.1 / Т4.1</td><td>Теплопотери системы, кВт</td><td>3,330</td><td>сверка: должна совпасть с нагрузкой на циркуляцию</td></tr><tr><td>Т3.1 / Т4.1</td><td>Худшее кольцо</td><td>№ 3</td><td>кольцо с наибольшими потерями — по нему и подбирается насос</td></tr><tr><td>Т3.1 / Т4.1</td><td>Потери худшего кольца, кПа</td><td>0,766</td><td>трубы вместе с балансировочными клапанами</td></tr><tr><td>Т3.1 / Т4.1</td><td>Требуемый напор, м вод. ст.</td><td>0,079</td><td>Δp/(ρ·g) по горячей воде, ρ = 983 кг/м³</td></tr><tr><td>Т3.1 / Т4.1</td><td>Запас напора, раз</td><td>1,2</td><td>из исходных данных: на зарастание труб, наладку и фильтр</td></tr><tr><td>Т3.1 / Т4.1</td><td>Напор с запасом, м вод. ст.</td><td>0,095</td><td>требуемый напор × запас — по нему и ищется насос</td></tr><tr><td>Т3.1 / Т4.1</td><td>Насос</td><td>Grundfos UP 20-07 N</td><td>самый слабый из подходящих: лишний напор уходит в клапаны и шумит</td></tr><tr><td>Т3.1 / Т4.1</td><td>Корпус</td><td>нержавеющая сталь</td><td>для ГВС обязательны бронза или нержавейка — вода питьевая и проточная</td></tr><tr><td>Т3.1 / Т4.1</td><td>Присоединение</td><td>G 3/4</td><td>по паспорту насоса</td></tr><tr><td>Т3.1 / Т4.1</td><td>Напор насоса в рабочей точке, м</td><td>0,635</td><td>H = H_max·(1 − (Q/Q_max)²), H_max = 0,7 м, Q_max = 1 м³/ч</td></tr><tr><td>Т3.1 / Т4.1</td><td>Фактический запас, раз</td><td>7,992</td><td>напор насоса к требуемому напору кольца</td></tr><tr><td>Т3.1 / Т4.1</td><td>Мощность, Вт</td><td>25</td><td>по паспорту, для расчёта электрики</td></tr><tr><td>Т3.1 / Т4.1</td><td>Отклонено</td><td>ALPHA2 25-40 — подходит по напору, но корпус чугунный — только отопление; Star-RS 25/4 — подходит по напору, но корпус чугунный — только отопление</td><td>почему не взяты остальные — чтобы отказ не был молчаливым</td></tr><tr><td>Т3.1 / Т4.1</td><td>Данные каталога</td><td>ориентировочные</td><td>характеристика приближена параболой по двум паспортным крайностям; перед выдачей сверьте с паспортом</td></tr><tr><td>Т3.1 / Т4.1</td><td>Замечание</td><td>запас 7,992-кратный: слабее в каталоге нет. Излишек напора придётся душить клапанами, проверьте их на шум</td><td></td></tr></tbody></table><h2>10. Проверочный расчёт</h2><p>Проверочный расчёт показывает, как заданный на ИТП расход разойдётся по кольцам сам, и что будет, если балансировочных клапанов не ставить. На результаты разделов 3—9 он не влияет: это отдельная задача, решаемая на той же сети.</p><h3>Таблица 16 — Распределение расхода по кольцам</h3><p class="about">Для каждого кольца — расход и температура в двух случаях: с балансировочными клапанами и без них. Столбец отклонения показывает, насколько расход без клапанов разойдётся с расчётным.</p><table><thead><tr><th>Система</th><th>Кольцо</th><th>Расход на ИТП, л/с</th><th>Задан</th><th>Расчётный расход, л/с</th><th>Клапан</th><th>Положение</th><th>по расчёту</th><th>Kv на нём</th><th>С клапанами: расход, л/с</th><th>доля, %</th><th>t в конце, °C</th><th>Без клапанов: расход, л/с</th><th>доля, %</th><th>t в конце, °C</th><th>Отклонение от расчётного, %</th><th>Δp кольца без клапанов, кПа</th><th>Замечание</th></tr></thead><tbody><tr><td>Т3.1 / Т4.1</td><td>1</td><td>0,0844</td><td>по расчёту</td><td>0,0273</td><td>—</td><td></td><td>—</td><td>—</td><td>0,0273</td><td>32,3</td><td>60,00</td><td>0,0151</td><td>17,9</td><td>56,65</td><td>-44,6</td><td>0,146</td><td>без клапанов не добирает 60 °C</td></tr><tr><td>Т3.1 / Т4.1</td><td>2</td><td>0,0844</td><td>по расчёту</td><td>0,0218</td><td>VALTEC VT.054 1/2" Low Flow (VT.054.NLF.04)</td><td></td><td>41</td><td>1,044</td><td>0,0216</td><td>25,6</td><td>59,97</td><td>0,0197</td><td>23,3</td><td>59,70</td><td>-9,6</td><td>0,146</td><td>без клапанов не добирает 60 °C</td></tr><tr><td>Т3.1 / Т4.1</td><td>3</td><td>0,0844</td><td>по расчёту</td><td>0,0161</td><td>VALTEC VT.054 1/2" Low Flow (VT.054.NLF.04)</td><td></td><td>32</td><td>0,696</td><td>0,0159</td><td>18,8</td><td>59,96</td><td>0,0229</td><td>27,2</td><td>61,22</td><td>42,3</td><td>0,146</td><td></td></tr><tr><td>Т3.1 / Т4.1</td><td>4</td><td>0,0844</td><td>по расчёту</td><td>0,0192</td><td>VALTEC VT.054 1/2" Low Flow (VT.054.NLF.04)</td><td></td><td>36</td><td>0,848</td><td>0,0196</td><td>23,2</td><td>60,06</td><td>0,0267</td><td>31,6</td><td>61,17</td><td>38,7</td><td>0,146</td><td></td></tr><tr><td>Т3.1 / Т4.1</td><td>Итог</td><td>0,0844</td><td>по расчёту</td><td>0,0844</td><td>все по расчёту</td><td></td><td></td><td></td><td>0,0844</td><td>100,0</td><td>напор 0,745 кПа</td><td>0,0844</td><td>100,0</td><td>напор 0,146 кПа</td><td></td><td></td><td>шагов: 3 и 7</td></tr></tbody></table><p class="about">Что означают столбцы:</p><table class="notes"><tbody><tr><td class="name">Система</td><td>имя зоны: пара подающей Т3 и циркуляционной Т4 с общим выходом из ИТП</td></tr><tr><td class="name">Кольцо</td><td>номер кольца, к которому относится строка</td></tr><tr><td class="name">Расход на ИТП, л/с</td><td>расход, от которого ведётся распределение</td></tr><tr><td class="name">Задан</td><td>расход взят расчётный или вписан вручную</td></tr><tr><td class="name">Расчётный расход, л/с</td><td>расход кольца по основному расчёту — то, что ему нужно</td></tr><tr><td class="name">Клапан</td><td>типоразмер балансировочного клапана</td></tr><tr><td class="name">Положение</td><td>настроечное положение клапана, если оно задано вручную. Пусто — положение из расчёта</td></tr><tr><td class="name">по расчёту</td><td>положение, подобранное увязкой</td></tr><tr><td class="name">Kv на нём</td><td>пропускная способность клапана в этом прогоне</td></tr><tr><td class="name">С клапанами: расход, л/с</td><td>сколько достанется кольцу при настроенных клапанах</td></tr><tr><td class="name">доля, %</td><td>доля кольца в общем расходе на ИТП</td></tr><tr><td class="name">t в конце, °C</td><td>температура в самой дальней точке кольца — та, что должна получиться у потребителя</td></tr><tr><td class="name">Без клапанов: расход, л/с</td><td>сколько достанется, если клапанов не ставить вовсе</td></tr><tr><td class="name">доля, %</td><td>доля кольца в общем расходе на ИТП</td></tr><tr><td class="name">t в конце, °C</td><td>температура в самой дальней точке кольца — та, что должна получиться у потребителя</td></tr><tr><td class="name">Отклонение от расчётного, %</td><td>насколько расход без клапанов разойдётся с тем, что кольцу нужно</td></tr><tr><td class="name">Δp кольца без клапанов, кПа</td><td>потери кольца, когда душить его нечем</td></tr><tr><td class="name">Замечание</td><td>что в этой строке требует внимания</td></tr></tbody></table><h2>11. Схемы</h2><h3>Принципиальная схема</h3><p><img src="data:image/png;base64,"></p><h3>Трёхмерная схема</h3><p><img src="data:image/png;base64,"></p><h2>12. Замечания расчёта</h2><h3>Таблица 17 — Замечания и диагностика</h3><p class="about">Всё, что программа нашла в сети и сочла достойным внимания: разрывы, участки без изоляции, кольца, не добравшие требуемой температуры, расхождения методов.</p><table><thead><tr><th>Замечание</th></tr></thead><tbody><tr><td>Выходов ИТП собрано в пары «Т3 — Т4»: 1. Выход подачи и вход обратки замкнуты внутри ИТП — только после этого в графе появляется цикл, по которому и отделяются кольцевые участки.</td></tr><tr><td>Тупиковых участков: 0, суммарной длиной 0,00 м. В расчёт теплопотерь они не идут.</td></tr><tr><td>Итераций подбора расходов: 16. Суммарные теплопотери кольцевых участков: 3,330 кВт.</td></tr><tr><td>Общий циркуляционный расход подбором: 0,0844 л/с; по формуле q_cir = β·ΣQ/(c·Δt) при Δt = 5 К: 0,1617 л/с.</td></tr><tr><td>Расход по формуле СП выше подобранного в 1,92 раза. Подбор обеспечивает 60 °C у потребителя, формула дополнительно компенсирует остывание обратки Т4. Если нужен запас — принимайте больший.</td></tr><tr><td>Зона Т3.1 / Т4.1: самое невыгодное кольцо № 1, потери труб 0,74 кПа. Колец с клапаном: 3 из 4 (допустимая невязка 10,0 %).</td></tr><tr><td>Зона Т3.1 / Т4.1: требуемый напор насоса 0,77 кПа (0,079 м вод. ст.) при расходе 0,0844 л/с — по кольцу № 3. Подобран Grundfos UP 20-07 N, запас 7,992-кратный (данные каталога ориентировочные, сверьте с паспортом).</td></tr><tr><td>Зона Т3.1 / Т4.1: обратка на вводе ИТП 55,42 °C, подогрев 9,576 К, нагрузка на циркуляцию 3,330 кВт при теплопотерях 3,330 кВт.</td></tr></tbody></table><p class="about">Что означают столбцы:</p><table class="notes"><tbody><tr><td class="name">Замечание</td><td>что в этой строке требует внимания</td></tr></tbody></table><h2>13. Оговорки</h2><div class="caveat"><p><b>Стальные трубопроводы посчитаны как неновые.</b> Шероховатость принята по Ф. А. Шевелёву для труб, обросших отложениями, и зависит от диаметра: от 1,686 мм при Dвн 300 мм до 2,577 мм при 36 мм. Потери выходят примерно вдвое выше, чем по новой трубе. Это сделано сознательно: система ГВС работает десятилетиями, и расчёт по новой трубе занизил бы требуемый напор насоса.</p><p><b>Подбор насоса ориентировочный.</b> Характеристика каждого насоса приближена параболой по двум паспортным крайностям, а не задана по точкам. Перед выдачей проверьте рабочую точку по паспорту изготовителя. Корпус насоса для ГВС должен быть бронзовым или нержавеющим.</p><p><b>Местные сопротивления учтены долей от потерь по длине</b> (0,2), а не поэлементно. Для сетей ГВС это обычная практика, но если в системе есть нетиповые узлы с большим сопротивлением, их следует посчитать отдельно.</p><p><b>Разбор схемы.</b> Кольца и системы определены по геометрии и именам систем. Перед выдачей сверьте число колец и состав систем с проектом: разрыв в модели программа видит, но достроить отсутствующий участок за автора не может.</p></div></body></html>